# ---- Veri kaynağı ----
# Windows dev: EXCEL_PATH=Z:\RAPOR\Hakedis Takip.xlsx
# Ubuntu prod (gonoder ile): EXCEL_PATH=/opt/hakedis/data/hakedis.xlsx
EXCEL_PATH=/opt/hakedis/data/hakedis.xlsx

# ---- Auth ----
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-password
# Üret: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRES_MINUTES=480

# ---- Gonoder push token (gonoder/.env ile aynı olmalı) ----
PUSH_TOKEN=change-me-push-token

# ---- Cache ----
CACHE_TTL_SECONDS=5
LOAD_MAX_RETRIES=3
LOAD_RETRY_BACKOFF_SEC=1.0
STALE_TOLERANCE_SEC=300
