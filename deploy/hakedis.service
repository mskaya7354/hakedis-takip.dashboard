[Unit]
Description=Hakedis Takip API (FastAPI/Uvicorn)
After=network.target

[Service]
Type=simple
User=hakedis
Group=hakedis
WorkingDirectory=/opt/hakedis/backend
EnvironmentFile=/opt/hakedis/backend/.env
ExecStart=/opt/hakedis/backend/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port __UVICORN_PORT__ \
    --workers 1 \
    --no-access-log
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
